LoginServlet.java

package mypack;
import java.io.*;
import java.sql.*;
import javax.servlet.*;
import javax.servlet.http.*;

public class LoginServlet extends HttpServlet {
    protected void doPost(HttpServletRequest req,HttpServletResponse res)
    throws ServletException,IOException {
        PrintWriter out=res.getWriter();
        out.println("<h1>Trying to connect DB...</h1>");
        try {
            Class.forName("com.mysql.cj.jdbc.Driver");
            Connection con=DriverManager.getConnection(
                "jdbc:mysql://localhost:3306/mydb","root","thilak");
            PreparedStatement ps=con.prepareStatement(
                "select uname from login where uname=? and password=?");
            ps.setString(1,req.getParameter("txtName"));
            ps.setString(2,req.getParameter("txtPwd"));
            ResultSet rs=ps.executeQuery();

            out.println("<body bgcolor='lightgreen'><div align='center'>");
            if(rs.next()) {
                out.println("<h1>Connection to DB successful</h1>");
                out.println("<h1>Login succes</h1>");
            } else {
                out.println("<h1 style='color:red'>Login failed</h1>");
                out.println("<h1 style='color:red'>Try with Correct Uname and Pwd</h1>");
            }
            out.println("</div></body>");
            con.close();
        } catch(Exception e) {
            e.printStackTrace();
        }
    }
}


