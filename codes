    public void movepage(View v) {
        String stname = urname.getText().toString().trim();
        String stphoneno = urphoneno.getText().toString().trim();
        if (stname.equals("usha") && stphoneno.equals("9941775863")) {
            Intent in = new Intent(MainActivity.this, Main2Activity.class);
            in.putExtra("name_key", stname);
            in.putExtra("phone_key", stphoneno);
            startActivity(in);
        } else if (stname.equals("") || stphoneno.equals("")) {
            Toast.makeText(getBaseContext(), "ENTER BOTH NAME AND PHONE NUMBER", Toast.LENGTH_LONG).show();
        } else {
            Toast.makeText(getBaseContext(), "WRONG NAME AND PHONE NUMBER ENTERED", Toast.LENGTH_LONG).show();
        }
    }
}

